{% comment %}Shared quote layout used across sources when the polling data contract matches.{% endcomment %}
{% assign quote_list = IDX_0.quotes %}
{% assign quote_count = quote_list.size | minus: 1 %}
{% assign quote_index = 0 | random_number: quote_count | plus: 0 %}
{% assign quote = quote_list[quote_index] %}
{% assign speaker = IDX_1[quote.speaker] %}
{% assign speaker_name = speaker.name | default: quote.speaker %}
{% assign portrait_url = "" %}
{% if speaker.image %}
  {% assign portrait_path = speaker.image | remove_first: "../" %}
  {% capture portrait_url %}https://raw.githubusercontent.com/Kaskelotval/trmnl-quotes/main/sources/disco-elysium/{{ portrait_path }}{% endcapture %}
{% endif %}
<style>
  .portrait { width: 130px; height: 130px; object-fit: cover;}
</style>
<div class="layout" style="display: flex; flex-direction: column; align-items: center; text-align: center; padding: 1.5em;">
  {% if quote %}
    {% if quote.text.size > 150 %}
      {% assign quote_size = "title--small lg:title--large" %}
    {% else %}
      {% assign quote_size = "title lg:title--xlarge" %}
    {% endif %}
    {% if portrait_url != "" and quote.text.size <= 220 %}
      <img class="image portrait" src="{{ portrait_url }}" alt="{{ speaker_name | escape }}">
    {% endif %}
    <div class="markdown" style="margin-top: 1em;">
      <div class="title {{ quote_size }}" style="white-space: pre-wrap;">{{ quote.text | escape }}</div>
      <span class="label lg:label--large" style="display: block; margin-top: 8px;">— {{ speaker_name | escape }}</span>
      {% if quote.location %}
        <span class="description lg:description--xlarge" style="display: block; margin-top: 4px;">{{ quote.location | escape }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>
