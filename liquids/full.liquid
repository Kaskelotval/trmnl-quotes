{% comment %}Shared quote layout used across sources when the polling data contract matches.{% endcomment %}
{% assign quote_list = IDX_0.quotes %}
{% assign quote_count = quote_list.size | minus: 1 %}
{% assign quote_index = 0 | random_number: quote_count | plus: 0 %}
{% assign quote = quote_list[quote_index] %}
{% assign speaker = IDX_1[quote.speaker] %}
{% assign speaker_name = speaker.name | default: quote.speaker %}
{% assign portrait_url = "" %}
{% if speaker.image %}
  {% assign portrait_path = speaker.image | remove_first: "../" %}
  {% capture portrait_url %}https://raw.githubusercontent.com/Kaskelotval/trmnl-quotes/main/sources/disco-elysium/{{ portrait_path }}{% endcapture %}
{% endif %}
<style>
  .portrait { width: 220px; height: 220px; object-fit: cover; margin: auto; }
  .portrait-col { width: 28%; }
  .quote-col { width: 72%; }
</style>
<div class="layout">
  {% if quote %}
    {% if quote.text.size > 150 %}
      {% assign quote_size = "title--base lg:title--xlarge" %}
    {% else %}
      {% assign quote_size = "title--large lg:title--xxlarge" %}
    {% endif %}
    <div class="columns" style="padding: 2em; align-items: center;">
      {% if portrait_url != "" %}
        <div class="column portrait-col">
          <img class="image portrait" src="{{ portrait_url }}" alt="{{ speaker_name | escape }}">
        </div>
      {% endif %}
      <div class="column quote-col" style="{% if portrait_url == "" %}width: 100%;{% endif %}">
        <div class="markdown">
          <div class="title {{ quote_size }}" style="white-space: pre-wrap;">{{ quote.text | escape }}</div>
          <span class="label lg:label--large" style="margin-top: 12px; display: block;">— {{ speaker_name | escape }}</span>
          {% if quote.location %}
            <span class="description lg:description--xlarge" style="display: block; margin-top: 6px;">{{ quote.location | escape }}</span>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
</div>
